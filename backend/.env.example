PORT=5000
DATABASE_URL="file:./dev.db"
# Generate a private one: openssl rand -base64 48
# Production refuses to boot on a value published in this repo, or under 32 chars.
JWT_SECRET="replace_with_a_secure_random_key_in_production"

# Password for the two admin accounts created on an empty database.
# Production refuses to boot without it (min 12 chars). Change it in the
# admin portal after the first login.
ADMIN_INITIAL_PASSWORD="change_me_before_first_boot"
CORS_ORIGIN="http://localhost:5173"
NODE_ENV="development"

# Optional SMTP configuration for email alerts
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"
# ADMIN_ALERT_EMAIL="admin@yourcompany.com"

# Only for an SMTP server with a genuinely broken certificate. Leave unset:
# setting it disables certificate verification on the mail connection.
# SMTP_INSECURE_TLS="false"

