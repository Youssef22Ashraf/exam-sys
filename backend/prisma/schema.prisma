// Prisma Schema for Workplace Assessment System
// Supports SQLite for local zero-config development, and PostgreSQL in production

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Candidate {
  id             String        @id @default(uuid())
  name           String
  email          String        @unique
  companyId      String
  registeredAt   DateTime      @default(now())
  status         String        @default("Registered") // Registered | In Progress | Completed
  totalAttempts  Int           @default(0)
  highestScore   Int?
  latestScore    Int?
  lastAttemptAt  DateTime?
  cooldownClearedAt DateTime?   // admin override; attempts at or before this no longer count toward the 48-hour window
  attempts       ExamAttempt[]

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([companyId])
  @@index([registeredAt])
  @@index([status])
}

model Question {
  id            Int      @id
  section       String   // "A" or "B"
  sectionTitle  String
  question      String
  options       String   // JSON stringified array of string options
  correctAnswer Int      // 0-indexed index of correct option

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ExamAttempt {
  id                String    @id @default(uuid())
  candidateId       String
  candidate         Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  candidateName     String
  candidateEmail    String
  companyId         String
  submittedAt       DateTime  @default(now())
  score             Int
  totalQuestions    Int
  percentage        Float
  isPassed          Boolean
  timeSpentSeconds  Int
  partAScore        Int
  partATotal        Int
  partBScore        Int
  partBTotal        Int
  answers           String    // JSON stringified object of questionId -> selectedOptionIndex
  tabSwitches       Int       @default(0)
  proctoringStatus  String    @default("Verified") // "Verified" | "Warnings" | "Camera Disabled"
  candidatePhoto    String?   // Filename or base64 snapshot
  hasVideoRecording Boolean   @default(false)
  videoFilename     String?   // Recorded .webm filename in uploads/videos/
  attemptNumber     Int       @default(1)

  createdAt         DateTime  @default(now())

  // Prisma does not create an index for a relation field on SQLite, so
  // candidateId was an unindexed foreign key on the largest table -- used by
  // every history lookup and every cascade delete.
  @@index([candidateId])
  // services/cooldown.ts filters on candidateEmail OR companyId and orders by
  // submittedAt, on every register, check-cooldown and submit.
  @@index([candidateEmail])
  @@index([companyId])
  @@index([submittedAt])
}

model ExamSetting {
  id                 String   @id @default("default-settings")
  examTitle          String   @default("Workplace Assessment System")
  durationMinutes    Int      @default(30)
  passingPercentage  Int      @default(70)
  sectorBadge        String   @default("Engineering & Construction Sector")
  allowReviewAnswers Boolean  @default(true)
  notifyEmail        String?

  updatedAt          DateTime @updatedAt
}

model AdminUser {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// A server-owned exam sitting. Created by POST /api/exam/start when the
/// candidate opens the exam, and consumed by POST /api/exam/submit.
///
/// Exists because the client used to supply timeSpentSeconds, tabSwitches and
/// proctoringStatus in the submit body — the proctored party reporting on
/// itself. startedAt gives the server its own clock, and serverWarnings is
/// incremented by the candidate:warning socket handler, not by the payload.
model ExamSession {
  id             String    @id @default(uuid())
  candidateEmail String
  companyId      String
  startedAt      DateTime  @default(now())
  serverWarnings Int       @default(0)
  attemptId      String?   // set once the sitting is submitted; blocks reuse
  createdAt      DateTime  @default(now())

  @@index([candidateEmail])
  @@index([startedAt])
}
